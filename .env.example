# Copy to .env and fill in. Sandbox credentials only. Never put live PayPal credentials here.
APP_ENV=dev                # dev | demo
CS_MODE=full               # full | baseline
PUBLIC_BASE_URL=http://localhost:8000

# Ablations (refused when APP_ENV=demo)
ABL_NO_GATE=0
ABL_NO_PRINCIPAL_LOCK=0
ABL_NO_BUDGET_RECON=0
ABL_NO_GLOBAL_NONCE=0
ABL_NO_STRICT_JSON=0
ABL_NO_PREAUTH_CHECK=0

DATABASE_URL=postgresql+psycopg://countersign:countersign@localhost:5432/countersign
# Role that may INSERT and SELECT (only) on the decision log. The migration creates it NOLOGIN;
# the operator sets its login and password out of band.
LEDGER_APP_ROLE=countersign_app

# PayPal sandbox
PAYPAL_API_BASE=https://api-m.sandbox.paypal.com
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=

# Merchant signing key (ES256), generated by `make keys` into secrets/
MERCHANT_KEY_PATH=secrets/merchant_es256.jwk.json

# LLM provider (ids confirmed on Day 0)
LLM_PROVIDER=
LLM_API_KEY=
LLM_MODEL_AGENT=
LLM_MODEL_ASSISTANT=
