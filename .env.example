# Copy to .env and fill in. Sandbox credentials only. Never put live PayPal credentials here.
APP_ENV=dev                # dev | demo
CS_MODE=full               # full | baseline (baseline = the naive gateway used for comparisons)
PUBLIC_BASE_URL=http://localhost:8000

# Ablations (refused when APP_ENV=demo)
ABL_NO_GATE=0
ABL_NO_PRINCIPAL_LOCK=0
ABL_NO_BUDGET_RECON=0
ABL_NO_GLOBAL_NONCE=0
ABL_NO_STRICT_JSON=0
ABL_NO_PREAUTH_CHECK=0

DATABASE_URL=postgresql+psycopg://countersign:countersign@localhost:5432/countersign
# Role that may INSERT and SELECT (only) on the decision log. The migration creates it NOLOGIN;
# the operator sets its login and password out of band.
LEDGER_APP_ROLE=countersign_app

# PayPal sandbox
PAYPAL_API_BASE=https://api-m.sandbox.paypal.com
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=

# The trusted platform provider's ES256 key (Decision 5), generated by `make keys` into secrets/. Its
# private half signs the open mandates after consent; its public half verifies them. Without it no
# mandate verifies and no consent is accepted.
PLATFORM_KEY_PATH=secrets/platform_es256.jwk.json
MERCHANT_ID=merchant-1
MERCHANT_NAME=Countersign demo store
PAYPAL_MERCHANT_ID=

# Merchant signing key (ES256), generated by `make keys` into secrets/
MERCHANT_KEY_PATH=secrets/merchant_es256.jwk.json

# Model gateway (docs/PROTOCOL.md Decisions 94 to 97). Any OpenAI-compatible chat completions endpoint.
# Credentials are read from the environment only; keep them EMPTY here and never commit a value.
# LLM_MODE: replay (default, reads eval/cassettes/llm, no network), record, or live.
LLM_MODE=
LLM_PROVIDER=
LLM_BASE_URL=
LLM_MODEL=
LLM_API_KEY=
# Optional: LLM_MAX_CALLS (per run, default 50), LLM_RATE_PER_MINUTE (default 10),
# LLM_RESPONSE_FORMAT (json_schema, json_object or text; default json_object), LLM_SEED.
